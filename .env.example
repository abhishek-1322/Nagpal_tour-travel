# Password for the admin panel at /admin (required to enable it)
ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: separate secret for signing admin sessions. Defaults to one derived from ADMIN_PASSWORD.
# ADMIN_SECRET=

# Set automatically on Vercel when you connect a Blob store (Storage → Blob).
# Without it, uploads are saved to ./storage on this server.
# BLOB_READ_WRITE_TOKEN=

# Optional: folder for local uploads (default ./storage)
# MEDIA_DIR=
